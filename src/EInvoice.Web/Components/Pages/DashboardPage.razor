@page "/dashboard"
@attribute [Authorize(Policy = Policies.ReadInvoices)]
@using EInvoice.Application.Kpi
@inject Operations Operations

<PageTitle>@T["Page.Title", T["Dashboard.Title"]]</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">@T["Dashboard.Title"]</MudText>

@if (_data is not { } data)
{
    <MudProgressLinear Indeterminate="true" aria-label="@T["Dashboard.Loading"]" />
}
else
{
    <MudGrid Spacing="3">
        @* ---- Posting health ----------------------------------------------------------------------------------- *@
        <MudItem xs="12">
            @{ var (state, icon, severity, text) = PostingState(data.Posting); }
            <MudAlert Severity="severity" Icon="@icon" data-testid="kpi-posting" data-state="@state" role="status">
                <strong>@T["Dashboard.Posting"]</strong> @text
                <span class="ml-2">@PostingCounts(data.Posting)</span>
            </MudAlert>
        </MudItem>

        @* ---- Invoices by status ------------------------------------------------------------------------------- *@
        <MudItem xs="12" md="6">
            <MudPaper Outlined="true" Class="pa-4" data-testid="kpi-status">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@T["Dashboard.ByStatus"]</MudText>
                <MudSimpleTable Elevation="0" Dense="true">
                    <thead><tr><th scope="col">@T["Common.Status"]</th><th scope="col" class="text-right">@T["Dashboard.Invoices"]</th><th scope="col" class="text-right">@T["Dashboard.GrossEur"]</th></tr></thead>
                    <tbody>
                        @foreach (var s in data.ByStatus)
                        {
                            <tr>
                                <td><StatusChip Status="s.Status" /></td>
                                <td class="text-right tabular">@s.InvoiceCount</td>
                                <td class="text-right tabular nowrap">@Formats.Money(s.GrossTotalEur, "EUR")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        @* ---- Open exception reasons --------------------------------------------------------------------------- *@
        <MudItem xs="12" md="6">
            <MudPaper Outlined="true" Class="pa-4" data-testid="kpi-reasons">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@T["Dashboard.Reasons"]</MudText>
                @if (data.OpenReasons.Count == 0)
                {
                    <MudText>@T["Dashboard.NoReasons"]</MudText>
                }
                else
                {
                    <MudSimpleTable Elevation="0" Dense="true">
                        <thead><tr><th scope="col">@T["Dashboard.Reason"]</th><th scope="col" class="text-right">@T["Dashboard.Invoices"]</th></tr></thead>
                        <tbody>
                            @foreach (var r in data.OpenReasons)
                            {
                                <tr><td>@ReasonText(r)</td><td class="text-right tabular">@r.OpenInvoices</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>

        @* ---- Monthly throughput ------------------------------------------------------------------------------- *@
        <MudItem xs="12">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">@T["Dashboard.Months"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    @T["Dashboard.MonthsIntro"]
                </MudText>
                <MudSimpleTable Elevation="0" Dense="true">
                    <thead>
                        <tr>
                            <th scope="col">@T["Dashboard.Month"]</th><th scope="col" class="text-right">@T["Common.Received"]</th><th scope="col" class="text-right">@T["Dashboard.StraightThrough"]</th>
                            <th scope="col" class="text-right">@T["Dashboard.Rate"]</th><th scope="col" class="text-right">@T["Dashboard.Exceptions"]</th><th scope="col" class="text-right">@T["Status.Failed"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in data.Months)
                        {
                            <tr data-testid="kpi-month">
                                <td class="nowrap">@Formats.MonthName(m.Month)</td>
                                <td class="text-right tabular">@m.Received</td>
                                <td class="text-right tabular">@m.StraightThrough</td>
                                <td class="text-right tabular">@(m.StraightThroughPercent is { } p ? Formats.Percent1(p) : "–")</td>
                                <td class="text-right tabular">@m.Exceptions</td>
                                <td class="text-right tabular">@m.Failed</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private Dashboard? _data;

    protected override async Task OnInitializedAsync() =>
        _data = await Operations.RunAsync<IKpiQueries, Dashboard>(q => q.DashboardAsync(Formats.TodayInBerlin(), CancellationToken.None));

    /// <summary>A match outcome and a rule code get the same words as on the invoice page.</summary>
    private string ReasonText(ReasonKpi reason) =>
        reason.Kind == "Match" && Enum.TryParse<MatchOutcome>(reason.Reason, out var outcome) ? Labels.Outcome(T, outcome) : Labels.Rule(T, reason.Reason);

    private string PostingCounts(PostingKpi p) =>
        T["Dashboard.PostingCounts", p.Posted, p.WaitingToPost, p.Retrying, p.Failed]
        + (p.OldestWaitingSince is { } since ? T["Dashboard.OldestWaiting", Formats.Timestamp(since)] : string.Empty);

    private (string State, string Icon, Severity Severity, string Text) PostingState(PostingKpi posting) => posting switch
    {
        { Failed: > 0 } => ("failed", Icons.Material.Outlined.Error, Severity.Error, T["Dashboard.PostingFailed"]),
        { Retrying: > 0 } => ("retrying", Icons.Material.Outlined.Sync, Severity.Warning, T["Dashboard.PostingRetrying"]),
        _ => ("healthy", Icons.Material.Outlined.CheckCircle, Severity.Success, T["Dashboard.PostingHealthy"]),
    };
}
