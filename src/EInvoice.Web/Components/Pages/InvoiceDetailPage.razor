@page "/invoices/{Id:guid}"
@attribute [Authorize(Policy = Policies.ReadInvoices)]
@implements IDisposable
@using EInvoice.Application.Approval
@using EInvoice.Application.Explanation
@using EInvoice.Application.Matching
@using EInvoice.Application.Validation
@using EInvoice.Web.Api
@using EInvoice.Web.Configuration
@using Microsoft.Extensions.Options
@inject Operations Operations
@inject IExceptionExplainer Explainer
@inject IAuthorizationService Authorization
@inject IOptions<ApprovalSettings> ApprovalSettings

@if (!_loaded)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@T["Detail.Loading"]" />
}
else if (_invoice is null)
{
    <PageTitle>@T["Page.Title", T["Detail.NotFound"]]</PageTitle>
    <MudPaper Outlined="true" Class="pa-6" data-testid="not-found">
        <MudText Typo="Typo.h5" HtmlTag="h1">@T["Detail.NotFound"]</MudText>
        <MudText Class="my-2">@T["Detail.NotFoundText"]</MudText>
        <MudLink Href="/">@T["Detail.BackToInbox"]</MudLink>
    </MudPaper>
}
else
{
    var invoice = _invoice;
    <PageTitle>@T["Page.Title", invoice.InvoiceNumber ?? T["Detail.Invoice"]]</PageTitle>

    <MudLink Href="/" Typo="Typo.body2" Class="d-inline-flex align-center mb-2">
        <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" Class="mr-1" aria-hidden="true" /> @T["Nav.Inbox"]
    </MudLink>

    @* ---- Header ---------------------------------------------------------------------------------------- *@
    <MudPaper Outlined="true" Class="pa-4 mb-3">
        <div class="d-flex flex-wrap align-center gap-3">
            <MudText Typo="Typo.h4" HtmlTag="h1">@(invoice.InvoiceNumber ?? T["Common.NotReadable"])</MudText>
            <StatusChip Status="invoice.Status" />
            @if (invoice.SourceFormat == SourceFormat.Pdf)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Outlined.AutoAwesome" Class="ma-0"
                         data-testid="ai-extracted" title="@T["Detail.AiChipHelp"]">@T["Detail.AiChip"]</MudChip>
            }
            else if (invoice.SourceFormat == SourceFormat.Zugferd)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Icon="@Icons.Material.Outlined.DataObject" Class="ma-0"
                         data-testid="zugferd" title="@T["Detail.ZugferdChipHelp"]">@T["Detail.ZugferdChip"]</MudChip>
            }
            <MudSpacer />
            @if (CanRematch(invoice))
            {
                <AuthorizeView Policy="@Policies.RematchInvoices" Context="auth">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Sync" Disabled="_rematching"
                               OnClick="RematchAsync" data-testid="rematch">@(_rematching ? T["Detail.Rematching"] : T["Detail.Rematch"])</MudButton>
                </AuthorizeView>
            }
        </div>

        <dl class="facts mt-3">
            <div><dt>@T["Common.Vendor"]</dt><dd data-testid="vendor">@(invoice.VendorName ?? T["Common.UnknownVendor"])</dd></div>
            <div><dt>@T["Common.PurchaseOrder"]</dt><dd data-testid="order">@if (invoice.PurchaseOrderNumber is { } orderNumber)
                {
                    @* What it is matched against: every invoice reader may read the orders. *@
                    <MudLink Href="@($"/purchasing?q={Uri.EscapeDataString(orderNumber)}")" Underline="Underline.Always">@orderNumber</MudLink>
                }
                else
                {
                    <span>–</span>
                }</dd></div>
            <div><dt>@T["Common.IssueDate"]</dt><dd>@Formats.Date(invoice.IssueDate)</dd></div>
            <div><dt>@T["Common.Net"]</dt><dd class="tabular" data-testid="net">@Formats.Money(invoice.NetTotal, invoice.Currency)</dd></div>
            <div><dt>@T["Common.Vat"]</dt><dd class="tabular" data-testid="tax">@Formats.Money(invoice.TaxTotal, invoice.Currency)</dd></div>
            <div><dt>@T["Common.Gross"]</dt><dd class="tabular strong" data-testid="gross">@Formats.Money(invoice.GrossTotal, invoice.Currency)</dd></div>
        </dl>

        @if (invoice.Status == InvoiceStatus.Failed && invoice.History.LastOrDefault()?.Reason is { } failure)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" data-testid="failure-reason">
                @T["Detail.FailedBecause"] <span lang="en">@failure</span>
            </MudAlert>
        }

        @if (_rematchMessage is not null)
        {
            <MudAlert Severity="_rematchSeverity" Class="mt-3" data-testid="rematch-result" role="status">@_rematchMessage</MudAlert>
        }
    </MudPaper>

    @* ---- Decision ----------------------------------------------------------------------------------------- *@
    @if (_decisionMessage is not null)
    {
        <MudAlert Severity="_decisionSeverity" Class="mb-3" data-testid="decision-result" role="status">
            @_decisionMessage
            @if (_decisionConflict)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ReloadAsync" data-testid="decision-reload" Class="ml-2">@T["Detail.Reload"]</MudButton>
            }
        </MudAlert>
    }

    @if (ApprovalRules.IsWaiting(invoice.Status) && _approver is { } approver)
    {
        <AuthorizeView Policy="@Policies.DecideInvoices" Context="auth">
            <MudPaper Outlined="true" Class="pa-4 mb-3" data-testid="decision">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@T["Detail.Decision"]</MudText>
                @if (ApprovalRules.IsOwn(invoice.SubmittedBy, approver))
                {
                    <MudText>@T["Decision.OwnInvoice"]</MudText>
                }
                else
                {
                    var approveBlock = ApprovalRules.WhyNotApprove(approver, invoice.GrossTotal, invoice.Currency,
                        invoice.Findings.Any(f => f.Severity == FindingSeverity.Blocking));
                    var reasonMissing = string.IsNullOrWhiteSpace(_reason);
                    var approveNeedsReason = ApprovalRules.ReasonRequired(Decision.Approve, invoice.Status);
                    <div data-testid="decision-reason">
                        <MudTextField T="string" @bind-Value="_reason" Immediate="true" Lines="3" MaxLength="@ApprovalLimits.MaxReasonLength"
                                      Counter="@ApprovalLimits.MaxReasonLength" Variant="Variant.Outlined" Label="@T["Detail.Reason"]"
                                      HelperText="@(approveNeedsReason ? T["Detail.ReasonBoth"] : T["Detail.ReasonReject"])" />
                    </div>
                    @if (approveBlock is not null)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2 d-flex align-center gap-1" data-testid="approve-blocked">
                            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" aria-hidden="true" /> @DecisionText(approveBlock.Outcome)
                        </MudText>
                    }
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Outlined.Check" data-testid="approve"
                                   Disabled="@(_deciding || approveBlock is not null || (approveNeedsReason && reasonMissing))"
                                   OnClick="() => DecideAsync(Decision.Approve)">@T["Detail.Approve"]</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Close" data-testid="reject"
                                   Disabled="@(_deciding || reasonMissing)"
                                   OnClick="() => DecideAsync(Decision.Reject)">@T["Detail.Reject"]</MudButton>
                    </div>
                }
            </MudPaper>
        </AuthorizeView>
    }

    @* ---- Why is this an exception? ------------------------------------------------------------------- *@
    @if (invoice.Status == InvoiceStatus.Exception)
    {
        var rules = Explanations.For(T, invoice);
        <MudPaper Outlined="true" Class="pa-4 mb-3" data-testid="explanation">
            <div class="d-flex flex-wrap align-center gap-3 mb-2">
                <MudText Typo="Typo.h6" HtmlTag="h2">@T["Detail.WhyException"]</MudText>
                <MudSpacer />
                @if (Explainer.UsesAi)
                {
                    <AuthorizeView Policy="@Policies.ExplainWithAi" Context="auth">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.AutoAwesome" Disabled="_explaining"
                                   OnClick="ExplainWithAiAsync" data-testid="explain-ai">@(_explaining ? T["Detail.Explaining"] : T["Detail.ExplainWithAi"])</MudButton>
                    </AuthorizeView>
                }
            </div>
            @foreach (var line in rules.Problems)
            {
                <MudText Typo="Typo.body2">@line</MudText>
            }
            <MudText Typo="Typo.subtitle2" Class="mt-2">@T["Detail.NextStep"]</MudText>
            @foreach (var line in rules.Steps)
            {
                <MudText Typo="Typo.body2">@line</MudText>
            }

            @if (_aiExplanation is { Source: ExplanationSource.Ai } ai)
            {
                <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Outlined.AutoAwesome" Class="mt-3" data-testid="explanation-ai" role="status">
                    <MudText Typo="Typo.subtitle2">@T["Detail.AiSuggestion"]</MudText>
                    @* The model writes English; its numbers are checked against the facts (ExplanationFacts). *@
                    <MudText Typo="Typo.body2" lang="en">@ai.Text</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1"><strong>@T["Detail.AiStep"]</strong> <span lang="en">@ai.SuggestedStep</span></MudText>
                </MudAlert>
            }
            else if (_aiExplanation is { FallbackReason: { } reason })
            {
                <MudAlert Severity="Severity.Normal" Class="mt-3" data-testid="explanation-fallback" role="status">
                    @T["Detail.AiNotUsed"] <span lang="en">@reason</span> @T["Detail.AiNotUsedAfter"]
                </MudAlert>
            }
        </MudPaper>
    }

    @* ---- Findings -------------------------------------------------------------------------------------- *@
    @if (invoice.Findings.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-3">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@T["Detail.Findings"]</MudText>
            <div class="table-scroll">
                <MudSimpleTable Elevation="0" Dense="true">
                    <thead><tr><th scope="col">@T["Detail.Severity"]</th><th scope="col">@T["Detail.Rule"]</th><th scope="col">@T["Detail.Finding"]</th><th scope="col">@T["Common.Line"]</th></tr></thead>
                    <tbody>
                        @foreach (var finding in invoice.Findings)
                        {
                            <tr data-testid="finding">
                                <td>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Labels.SeverityColor(finding.Severity)" Class="ma-0"
                                             Icon="@(finding.Severity == FindingSeverity.Blocking ? Icons.Material.Outlined.Block : Icons.Material.Outlined.Visibility)">
                                        @Labels.Severity(T, finding.Severity)
                                    </MudChip>
                                </td>
                                <td>@Labels.Rule(T, finding.RuleCode) <code class="code d-block">@finding.RuleCode</code></td>
                                @* As the rule recorded it: English, with the amounts and business terms it found. *@
                                <td lang="en">@finding.Message</td>
                                <td>@(finding.LinePosition?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "–")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        </MudPaper>
    }

    @* ---- Match panel ----------------------------------------------------------------------------------- *@
    <MudPaper Outlined="true" Class="pa-4 mb-3">
        <div class="d-flex flex-wrap align-baseline gap-3 mb-2">
            <MudText Typo="Typo.h6" HtmlTag="h2">@T["Detail.Match"]</MudText>
            @if (invoice.MatchResults.Count > 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="tolerance">@T["Detail.Tolerance"] @Formats.Rate(invoice.MatchResults[0].PriceTolerancePercent)</MudText>
            }
        </div>
        @if (invoice.MatchResults.Count == 0)
        {
            <MudText data-testid="no-match">
                @(invoice.Status == InvoiceStatus.Failed ? T["Detail.NotMatchedFailed"] : T["Detail.NotMatchedFindings"])
            </MudText>
        }
        else
        {
            <div class="table-scroll">
                <MudSimpleTable Elevation="0" Dense="true">
                    <thead>
                        <tr>
                            <th scope="col">@T["Common.Line"]</th>
                            <th scope="col">@T["Common.OrderLine"]</th>
                            <th scope="col">@T["Detail.Result"]</th>
                            <th scope="col" class="num">@T["Detail.InvoicePrice"]</th>
                            <th scope="col" class="num">@T["Detail.OrderPrice"]</th>
                            <th scope="col" class="num">@T["Detail.Difference"]</th>
                            <th scope="col" class="num">@T["Detail.InvoicedQuantity"]</th>
                            <th scope="col" class="num">@T["Detail.Available"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var match in invoice.MatchResults)
                        {
                            <tr data-testid="match-row" data-outcome="@match.Outcome.ToString()" class="@(match.Outcome == MatchOutcome.FullMatch ? null : "problem")">
                                <td>@match.InvoiceLineNumber</td>
                                <td>@(match.PurchaseOrderLineNumber?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "–")</td>
                                <td><OutcomeChip Outcome="match.Outcome" /></td>
                                <td class="num nowrap">@Formats.UnitPrice(match.InvoiceUnitPrice, invoice.Currency)</td>
                                <td class="num nowrap">@Formats.UnitPrice(match.OrderUnitPrice, invoice.Currency)</td>
                                <td class="num nowrap">@Formats.Percent(match.PriceVariancePercent)</td>
                                <td class="num" data-testid="qty-invoiced">@Formats.Quantity(match.QuantityInvoiced)</td>
                                <td class="num" data-testid="qty-available">@Formats.Quantity(match.QuantityAvailable)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </MudPaper>

    @* ---- Lines ------------------------------------------------------------------------------------------ *@
    @if (invoice.Lines.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-3">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@T["Detail.Lines"]</MudText>
            <div class="table-scroll">
                <MudSimpleTable Elevation="0" Dense="true">
                    <thead>
                        <tr>
                            <th scope="col">@T["Common.Line"]</th>
                            <th scope="col">@T["Common.Description"]</th>
                            <th scope="col" class="num">@T["Common.Quantity"]</th>
                            <th scope="col" class="num">@T["Common.UnitPrice"]</th>
                            <th scope="col" class="num">@T["Common.NetAmount"]</th>
                            <th scope="col" class="num">@T["Common.Vat"]</th>
                            <th scope="col">@T["Common.OrderLine"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in invoice.Lines)
                        {
                            <tr data-testid="line">
                                <td>@line.LineNumber</td>
                                <td>@line.Description</td>
                                <td class="num">@Formats.Quantity(line.Quantity)</td>
                                <td class="num nowrap">@Formats.UnitPrice(line.UnitPrice, invoice.Currency)</td>
                                <td class="num nowrap">@Formats.Money(line.NetAmount, invoice.Currency)</td>
                                <td class="num nowrap">@Formats.Rate(line.TaxRatePercent)</td>
                                <td>@(line.PurchaseOrderLineNumber?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "–")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        </MudPaper>
    }

    <div class="two-columns">
        @* ---- History --------------------------------------------------------------------------------------- *@
        <MudPaper Outlined="true" Class="pa-4 mb-3">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@T["Detail.History"]</MudText>
            <ol class="history">
                @foreach (var change in invoice.History)
                {
                    <li data-testid="history-entry">
                        <div class="d-flex flex-wrap align-center gap-2">
                            <StatusChip Status="change.To" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Formats.Timestamp(change.At) · @change.Actor</MudText>
                        </div>
                        @if (change.Reason is not null)
                        {
                            <MudText Typo="Typo.body2" Class="mt-1">@ChangeReason(change.Reason)</MudText>
                        }
                    </li>
                }
            </ol>
        </MudPaper>

        @* ---- Original file ------------------------------------------------------------------------------- *@
        @if (invoice.Document is { } document)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-3">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@T["Detail.OriginalFile"]</MudText>
                <MudText data-testid="file-name" Class="break-all">@document.FileName</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@Formats.FileSize(document.SizeBytes) · @T["Detail.ReceivedAt", Formats.Timestamp(document.ReceivedAt)]</MudText>
                @* "download": the browser saves the file (served as an attachment) and the Blazor router leaves the link alone. *@
                <MudButton Href="@($"/api/invoices/{invoice.Id}/document")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Download"
                           download="@document.FileName" data-testid="download">@T["Detail.Download"]</MudButton>
            </MudPaper>
        }
    </div>
}

@code {
    /// <summary>Who is signed in: recorded as the actor of what this page does.</summary>
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>The server's own check before an action: a hidden button is a convenience, not the protection.</summary>
    private async Task<bool> MayAsync(string policy) =>
        (await Authorization.AuthorizeAsync((await AuthState).User, policy)).Succeeded;
    private readonly CancellationTokenSource _disposed = new();
    private InvoiceDetail? _invoice;
    private bool _loaded;
    private bool _rematching;
    private string? _rematchMessage;
    private Severity _rematchSeverity;
    private Approver? _approver;
    private string? _reason;
    private bool _deciding;
    private string? _decisionMessage;
    private Severity _decisionSeverity;
    private bool _decisionConflict;
    private Explanation? _aiExplanation;
    private bool _explaining;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _rematchMessage = null;
        _aiExplanation = null;
        _decisionMessage = null;
        _reason = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _invoice = await Operations.RunAsync<IInvoiceQueries, InvoiceDetail?>(q => q.GetAsync(Id, _disposed.Token));
        var user = (await AuthState).User;
        _approver = user.Identity?.IsAuthenticated == true ? ApproverOf.User(user, ApprovalSettings.Value.DefaultLimitEur) : null;
        _loaded = true;
    }

    /// <summary>
    /// Sends the decision with the version this page shows: if the invoice changed since it was loaded, the server
    /// refuses with a conflict and the page offers a reload instead of deciding on something not seen.
    /// </summary>
    private async Task DecideAsync(Decision decision)
    {
        if (_invoice is null || !await MayAsync(Policies.DecideInvoices))
        {
            return;
        }

        _deciding = true;
        try
        {
            var approver = ApproverOf.User((await AuthState).User, ApprovalSettings.Value.DefaultLimitEur);
            var request = new DecisionRequest(Id, decision, _invoice.Version, string.IsNullOrWhiteSpace(_reason) ? null : _reason);
            var result = await Operations.RunAsync<IInvoiceApproval, DecisionResult>(a => a.DecideAsync(request, approver, _disposed.Token));
            _decisionConflict = result.Outcome == DecisionOutcome.Conflict;
            _decisionSeverity = result.Outcome switch
            {
                DecisionOutcome.Approved or DecisionOutcome.Rejected => Severity.Success,
                DecisionOutcome.Conflict => Severity.Warning,
                _ => Severity.Error,
            };
            _decisionMessage = DecisionText(result.Outcome);
            if (result.Outcome is DecisionOutcome.Approved or DecisionOutcome.Rejected)
            {
                _reason = null;
                await LoadAsync();
            }
        }
        finally
        {
            _deciding = false;
        }
    }

    private async Task ReloadAsync()
    {
        _decisionMessage = null;
        _decisionConflict = false;
        await LoadAsync();
    }

    /// <summary>What a decision did, or why it was refused, by its outcome; the numbers come from this page's data.</summary>
    private string DecisionText(DecisionOutcome outcome) => outcome switch
    {
        DecisionOutcome.OverLimit => T["Decision.OverLimit", Formats.Money(_approver?.LimitEur, "EUR")],
        DecisionOutcome.ReasonTooLong => T["Decision.ReasonTooLong", ApprovalLimits.MaxReasonLength],
        _ => T[$"Decision.{outcome}"],
    };

    /// <summary>
    /// A status change's reason. The pipeline writes codes ("PriceVariance, NoGoodsReceipt" or "IBAN_NOT_APPROVED"):
    /// those get their words. A person's reason or a recorded failure is shown as written.
    /// </summary>
    private string ChangeReason(string reason)
    {
        var parts = reason.Split(", ");
        var words = parts.Select(p => Enum.GetNames<MatchOutcome>().Contains(p, StringComparer.Ordinal)
            ? Labels.Outcome(T, Enum.Parse<MatchOutcome>(p))
            : T[$"Rule.{p}.Title"] is { ResourceNotFound: false } rule ? rule.Value : null).ToList();
        return words.All(w => w is not null) ? string.Join(", ", words) : reason;
    }

    /// <summary>Same rule as the use case: only an exception that comes from the match, not from findings.</summary>
    private static bool CanRematch(InvoiceDetail invoice) => invoice.Status == InvoiceStatus.Exception && invoice.Findings.Count == 0;

    private async Task RematchAsync()
    {
        if (!await MayAsync(Policies.RematchInvoices))
        {
            return;
        }

        _rematching = true;
        try
        {
            var actor = await SignedInUser.NameAsync(AuthState);
            var result = await Operations.RunAsync<IInvoiceRematch, RematchResult>(r => r.RematchAsync(Id, actor, _disposed.Token));
            _rematchSeverity = result.Outcome switch
            {
                RematchOutcome.Matched => Severity.Success,
                RematchOutcome.StillException => Severity.Warning,
                _ => Severity.Error,
            };
            _rematchMessage = result.Outcome == RematchOutcome.StillException
                ? T["Rematch.StillException", string.Join(", ", result.Reasons.Select(r => Labels.Outcome(T, r)))]
                : T[$"Rematch.{result.Outcome}"];
            _aiExplanation = null; // it described the invoice before the re-match
            await LoadAsync();
        }
        finally
        {
            _rematching = false;
        }
    }

    /// <summary>On request only: the model runs for invoices someone actually looks at. The result is never stored.</summary>
    private async Task ExplainWithAiAsync()
    {
        if (_invoice is null || !await MayAsync(Policies.ExplainWithAi))
        {
            return;
        }

        _explaining = true;
        try
        {
            _aiExplanation = await Explainer.ExplainAsync(_invoice, _disposed.Token);
        }
        finally
        {
            _explaining = false;
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
