@page "/"
@attribute [Authorize(Policy = Policies.ReadInvoices)]
@implements IDisposable
@using EInvoice.Application.Intake
@using EInvoice.Web.Api
@inject Operations Operations
@inject IntakeOptions IntakeOptions
@inject NavigationManager Navigation
@inject IAuthorizationService Authorization

<PageTitle>@T["Page.Title", T["Inbox.Title"]]</PageTitle>

<div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-3">
    <MudText Typo="Typo.h4" HtmlTag="h1">@T["Inbox.Title"]</MudText>

    @* The real file input stays focusable (visually hidden); the button is its label. Type checks happen on the server. *@
    <AuthorizeView Policy="@Policies.UploadInvoices">
        <div class="upload">
            <InputFile id="upload-input" class="visually-hidden" OnChange="UploadAsync" accept=".xml,application/xml,text/xml,.pdf,application/pdf" disabled="@(!CanUpload)" />
            <MudButton HtmlTag="label" for="upload-input" Variant="Variant.Filled" Color="Color.Primary" Disabled="!CanUpload"
                       StartIcon="@Icons.Material.Outlined.UploadFile">
                @(_uploading ? T["Inbox.Uploading"] : T["Inbox.Upload"])
            </MudButton>
        </div>
    </AuthorizeView>
</div>

@if (_uploadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" data-testid="upload-error" ShowCloseIcon="true" CloseIconClicked="() => _uploadError = null">
        @_uploadError
        @if (_existingInvoice is { } existing)
        {
            <MudLink Href="@($"/invoices/{existing}")" data-testid="existing-invoice" Class="ml-1">@T["Inbox.OpenExisting"]</MudLink>
        }
        @if (_uploadDetail is not null)
        {
            @* Only for a refused file type: the recorded reason (which format, which profile) as the server gave it. *@
            <div class="mt-1" data-testid="upload-detail">@T["Common.Detail"] @_uploadDetail</div>
        }
    </MudAlert>
}

<nav aria-label="@T["Inbox.FilterLabel"]" class="d-flex flex-wrap gap-2 mb-3">
    <MudButton Href="/" Size="Size.Small" Variant="@(_status is null ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
               data-testid="filter-all" aria-current="@(_status is null ? "page" : null)">@T["Inbox.All"]</MudButton>
    @foreach (var status in FilterStatuses)
    {
        var current = _status == status;
        <MudButton Href="@Link(status, 1)" Size="Size.Small" Variant="@(current ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                   data-testid="@($"filter-{status}")" aria-current="@(current ? "page" : null)">@Labels.Status(T, status)</MudButton>
    }
</nav>

@if (_page is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@T["Inbox.Loading"]" />
}
else if (_page.TotalCount == 0)
{
    <MudPaper Outlined="true" Class="pa-6 text-center" data-testid="empty">
        <MudText>
            @(_status is { } status ? T["Inbox.EmptyStatus", Labels.Status(T, status)] : T["Inbox.Empty"])
        </MudText>
    </MudPaper>
}
else
{
    <MudPaper Outlined="true" Class="table-scroll">
        <MudSimpleTable Elevation="0" Dense="true" Hover="true" FixedHeader="false">
            <thead>
                <tr>
                    <th scope="col">@T["Common.Status"]</th>
                    <th scope="col">@T["Inbox.InvoiceNumber"]</th>
                    <th scope="col">@T["Common.Vendor"]</th>
                    <th scope="col">@T["Common.IssueDate"]</th>
                    <th scope="col" class="num">@T["Inbox.Gross"]</th>
                    <th scope="col">@T["Common.Received"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in _page.Items)
                {
                    <tr data-testid="invoice-row">
                        <td><StatusChip Status="invoice.Status" /></td>
                        <td><MudLink Href="@($"/invoices/{invoice.Id}")" Underline="Underline.Always">@(invoice.InvoiceNumber ?? T["Common.NotReadable"])</MudLink>
                            @if (invoice.SourceFormat == SourceFormat.Pdf)
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" Class="ml-1 ai-mark" Title="@T["Inbox.AiBadge"]"
                                         aria-label="@T["Inbox.AiBadge"]" role="img" data-testid="ai-badge" />
                            }
                            else if (invoice.SourceFormat == SourceFormat.Zugferd)
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.DataObject" Size="Size.Small" Class="ml-1" Title="@T["Inbox.ZugferdBadge"]"
                                         aria-label="@T["Inbox.ZugferdBadge"]" role="img" data-testid="zugferd-badge" />
                            }
                        </td>
                        <td>@(invoice.VendorName ?? T["Common.UnknownVendor"])</td>
                        <td class="nowrap">@Formats.Date(invoice.IssueDate)</td>
                        <td class="num nowrap">@Formats.Money(invoice.GrossTotal, invoice.Currency)</td>
                        <td class="nowrap">@Formats.Timestamp(invoice.ReceivedAt)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <nav aria-label="@T["Paging.Label"]" class="d-flex align-center justify-end gap-2 mt-2">
        <MudText Typo="Typo.body2" data-testid="page-range">@RangeText()</MudText>
        @if (_page.Page > 1)
        {
            <MudButton Href="@Link(_status, _page.Page - 1)" Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ChevronLeft"
                       data-testid="page-prev">@T["Paging.Previous"]</MudButton>
        }
        @if (_page.Page * _page.PageSize < _page.TotalCount)
        {
            <MudButton Href="@Link(_status, _page.Page + 1)" Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Outlined.ChevronRight"
                       data-testid="page-next">@T["Paging.Next"]</MudButton>
        }
    </nav>
}

@code {
    /// <summary>Who is signed in: recorded as the actor of what this page does.</summary>
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>The server's own check before an action: a hidden button is a convenience, not the protection.</summary>
    private async Task<bool> MayAsync(string policy) =>
        (await Authorization.AuthorizeAsync((await AuthState).User, policy)).Succeeded;
    // Statuses an invoice can have after intake and later in its life; Received/Parsed/Validated are only passed through.
    private static readonly InvoiceStatus[] FilterStatuses =
        [InvoiceStatus.Exception, InvoiceStatus.Matched, InvoiceStatus.Failed, InvoiceStatus.Approved, InvoiceStatus.Rejected, InvoiceStatus.Posted];

    private readonly CancellationTokenSource _disposed = new();
    private InvoicePage? _page;
    private InvoiceStatus? _status;
    private bool _uploading;
    private string? _uploadError;
    private string? _uploadDetail;
    private Guid? _existingInvoice;

    // While the page is only prerendered nothing would handle a picked file; enable the upload once it is interactive.
    /// <summary>
    /// Not before the first interactive render has finished: InputFile attaches its browser listener after rendering,
    /// and a file chosen before that is silently lost. The listener setup is sent before the render that enables the
    /// button, on the same connection, so it is in place by the time the button can be used.
    /// </summary>
    private bool CanUpload => RendererInfo.IsInteractive && _ready && !_uploading;

    private bool _ready;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            _ready = true;
            StateHasChanged();
        }
    }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public string? PageQuery { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // The address is user input: anything that is not a status name or a positive number means "all" / page 1.
        _status = Enum.GetNames<InvoiceStatus>().FirstOrDefault(n => string.Equals(n, StatusQuery, StringComparison.OrdinalIgnoreCase)) is { } name
            ? Enum.Parse<InvoiceStatus>(name)
            : null;
        var page = int.TryParse(PageQuery, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var p) && p > 0 ? p : 1;

        var query = new InvoiceListQuery(_status, page, InvoiceListQuery.DefaultPageSize);
        _page = await Operations.RunAsync<IInvoiceQueries, InvoicePage>(q => q.ListAsync(query, _disposed.Token));
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (!await MayAsync(Policies.UploadInvoices))
        {
            return;
        }

        _uploadError = null;
        _uploadDetail = null;
        _existingInvoice = null;
        var file = e.File;
        if (file.Size > IntakeOptions.MaxDocumentBytes)
        {
            _uploadError = T["Intake.TooLarge", Formats.FileSize(IntakeOptions.MaxDocumentBytes)];
            return;
        }

        _uploading = true;
        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(IntakeOptions.MaxDocumentBytes, _disposed.Token))
            {
                await stream.CopyToAsync(buffer, _disposed.Token);
            }

            var upload = new UploadedFile(file.Name, buffer.ToArray());
            var actor = await SignedInUser.NameAsync(AuthState);
            var result = await Operations.RunAsync<IInvoiceIntake, IntakeResult>(intake => intake.SubmitAsync(upload, actor, _disposed.Token));
            if (result.Outcome == IntakeOutcome.Created)
            {
                Navigation.NavigateTo($"/invoices/{result.InvoiceId}");
                return;
            }

            // The refusal by its outcome, in the page's language. A refused type has several reasons (format, ZUGFeRD
            // profile, AI switched off): the server's reason is shown under it as recorded.
            _uploadError = result.Outcome == IntakeOutcome.TooLarge
                ? T["Intake.TooLarge", Formats.FileSize(IntakeOptions.MaxDocumentBytes)]
                : T[$"Intake.{result.Outcome}"];
            _uploadDetail = result.Outcome == IntakeOutcome.UnsupportedType ? result.Detail : null;
            _existingInvoice = result.Outcome == IntakeOutcome.DuplicateFile ? result.InvoiceId : null;
        }
        catch (IOException)
        {
            // The browser sent more than it announced, or the connection broke while reading.
            _uploadError = T["Inbox.ReadFailed"];
        }
        finally
        {
            _uploading = false;
        }
    }

    private static string Link(InvoiceStatus? status, int page) =>
        (status, page) switch
        {
            (null, 1) => "/",
            (null, _) => $"/?page={page}",
            (_, 1) => $"/?status={status}",
            _ => $"/?status={status}&page={page}",
        };

    private string RangeText()
    {
        var first = ((_page!.Page - 1) * _page.PageSize) + 1;
        var last = first + _page.Items.Count - 1;
        return T["Paging.Range", first, last, _page.TotalCount];
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
