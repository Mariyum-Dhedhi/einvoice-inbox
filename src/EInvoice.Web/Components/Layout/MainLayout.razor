@inherits LayoutComponentBase

<MudThemeProvider @ref="_themeProvider" Theme="AppTheme.Theme" @bind-IsDarkMode="_darkMode" ObserveSystemDarkModeChange="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6" Class="app-title">E-Invoice Inbox</MudLink>
        <nav aria-label="Main" class="app-nav">
            <AuthorizeView Policy="@Policies.ReadInvoices" Context="nav">
                <MudLink Href="/" Color="Color.Inherit" data-testid="nav-inbox">Inbox</MudLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.DecideInvoices" Context="nav">
                <MudLink Href="/approvals" Color="Color.Inherit" data-testid="nav-approvals">Approvals</MudLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.ManageUsers" Context="nav">
                <MudLink Href="/admin/users" Color="Color.Inherit" data-testid="nav-users">Users</MudLink>
            </AuthorizeView>
        </nav>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="app-subtitle">Accounts payable</MudText>
        <AuthorizeView>
            <Authorized>
                <span class="signed-in" data-testid="signed-in-user">@context.User.Identity?.Name</span>
                @* A POST form with a token, not a link: another site or an <img> cannot sign anyone out. *@
                <form method="post" action="@SignInSetup.LogoutPath" data-testid="sign-out" class="sign-out">
                    <AntiforgeryToken />
                    <button type="submit">Sign out</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">×</button>
</div>

@code {
    private MudThemeProvider? _themeProvider;
    private bool _darkMode;

    /// <summary>Light or dark follows the operating system setting.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
        {
            _darkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }
}
