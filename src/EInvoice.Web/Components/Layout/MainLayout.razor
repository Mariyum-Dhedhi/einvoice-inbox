@inherits LayoutComponentBase
@inject Microsoft.Extensions.Options.IOptions<DemoSettings> Demo

<MudThemeProvider @ref="_themeProvider" Theme="AppTheme.Theme" @bind-IsDarkMode="_darkMode" ObserveSystemDarkModeChange="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6" Class="app-title">@T["App.Name"]</MudLink>
        <nav aria-label="@T["Layout.MainNav"]" class="app-nav">
            <AuthorizeView Policy="@Policies.ReadInvoices" Context="nav">
                <MudLink Href="/" Color="Color.Inherit" data-testid="nav-inbox">@T["Nav.Inbox"]</MudLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.ReadInvoices" Context="nav">
                <MudLink Href="/dashboard" Color="Color.Inherit" data-testid="nav-dashboard">@T["Nav.Dashboard"]</MudLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.DecideInvoices" Context="nav">
                <MudLink Href="/approvals" Color="Color.Inherit" data-testid="nav-approvals">@T["Nav.Approvals"]</MudLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.ReadPurchasing" Context="nav">
                <MudLink Href="/purchasing" Color="Color.Inherit" data-testid="nav-purchasing">@T["Nav.Purchasing"]</MudLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.ReadAudit" Context="nav">
                <MudLink Href="/audit" Color="Color.Inherit" data-testid="nav-audit">@T["Nav.Audit"]</MudLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.ManageVendors" Context="nav">
                <MudLink Href="/admin/vendors" Color="Color.Inherit" data-testid="nav-vendors">@T["Nav.Vendors"]</MudLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.ManageUsers" Context="nav">
                <MudLink Href="/admin/users" Color="Color.Inherit" data-testid="nav-users">@T["Nav.Users"]</MudLink>
            </AuthorizeView>
        </nav>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="app-subtitle">@T["Layout.Subtitle"]</MudText>
        <LanguageSwitch />
        <AuthorizeView>
            <Authorized>
                <span class="signed-in" data-testid="signed-in-user">@context.User.Identity?.Name</span>
                @* A POST form with a token, not a link: another site or an <img> cannot sign anyone out. *@
                <form method="post" action="@SignInSetup.LogoutPath" data-testid="sign-out" class="sign-out">
                    <AntiforgeryToken />
                    <button type="submit">@T["Layout.SignOut"]</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        @if (Demo.Value.Enabled)
        {
            @* Text, not colour alone; a note, not an alert: it says the same on every page and is not news. *@
            <div class="demo-banner" role="note" data-testid="demo-banner">@T["Demo.Banner"]</div>
        }
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@* Present only once the page is interactive: browser tests wait for it, because server-rendered buttons do nothing
   until the live connection is up. Invisible and silent for people. *@
@if (_interactive)
{
    <span data-testid="app-ready" hidden></span>
}

<div id="blazor-error-ui" data-nosnippet>
    @T["Layout.Unhandled"]
    <a href="." class="reload">@T["Layout.Reload"]</a>
    <button type="button" class="dismiss" aria-label="@T["Common.Dismiss"]">×</button>
</div>

@code {
    private MudThemeProvider? _themeProvider;
    private bool _darkMode;
    private bool _interactive;

    /// <summary>Light or dark follows the operating system setting.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            _interactive = true;
            StateHasChanged();
        }

        if (firstRender && _themeProvider is not null)
        {
            _darkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }
}
