@inject NavigationManager Navigation

@*
    A page the user may not see, inside an open session: signed out (or the sign-in expired) goes to the login page,
    signed in without the role goes to "No access". Both come back to this address afterwards.
*@

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var signedIn = (await AuthState).User.Identity?.IsAuthenticated == true;
        var here = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        var target = signedIn ? SignInSetup.AccessDeniedPath : SignInSetup.LoginPath;
        Navigation.NavigateTo($"{target}?ReturnUrl={Uri.EscapeDataString(here)}", forceLoad: true);
    }
}
