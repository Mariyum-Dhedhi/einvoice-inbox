@page "/account/access-denied"
@attribute [Authorize]
@using System.Security.Claims

@* Any signed-in user may see this page: it explains why another page is closed to them. *@

<PageTitle>@T["Page.Title", T["AccessDenied.PageTitle"]]</PageTitle>

<AuthorizeView Context="auth">
    <section class="sign-in" aria-labelledby="denied-title">
        <h1 id="denied-title">@T["AccessDenied.Title"]</h1>
        <p>
            @T["AccessDenied.SignedInAs"] <strong data-testid="denied-user">@auth.User.Identity?.Name</strong>,
            <span data-testid="denied-roles">@RolesText(auth.User)</span>.
            @T["AccessDenied.Explain"]
        </p>
        <form method="post" action="@SignInSetup.LogoutPath" data-testid="sign-out">
            <AntiforgeryToken />
            <button type="submit">@T["AccessDenied.SignInAgain"]</button>
        </form>
    </section>
</AuthorizeView>

@code {
    private string RolesText(ClaimsPrincipal user)
    {
        var roles = user.FindAll(ClaimTypes.Role).Select(r => r.Value).Order(StringComparer.Ordinal).Select(r => Labels.Role(T, r)).ToList();
        return roles.Count == 0 ? T["AccessDenied.NoRole"] : T["AccessDenied.Roles", string.Join(", ", roles)];
    }
}
