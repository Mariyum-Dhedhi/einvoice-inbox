* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
# One pattern per line: gitattributes has no {a,b} brace expansion.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary

# Official test corpora are stored byte-exact (no line-ending normalisation).
testdata/**/kosit/*.xml -text

# Demo files are compared byte for byte with what the generator builds (DemoFileTests).
demo/invoices/*.xml -text
