# Copy to .env and set strong passwords. .env is git-ignored.
# SQL Server requires 8+ characters with three of: upper case, lower case, digits, symbols.
# Do not use quotes, backslashes or dollar signs.
MSSQL_SA_PASSWORD=
EINVOICE_APP_PASSWORD=
MSSQL_PORT=1433

# The app's client at the (mock) ERP: OAuth 2.0 client credentials. The mock ERP issues tokens to this client only,
# and the app uses the same values (Erp:ClientId and Erp:ClientSecret, as user secrets when run with dotnet run).
# Use a long random value, for example: openssl rand -hex 32
ERP_CLIENT_ID=einvoice
ERP_CLIENT_SECRET=

# Public demo only (docker compose --profile public, docs/self-hosting.md). The Tailscale auth key is a secret:
# create it in the Tailscale admin console; it stays in this file, which is never committed.
TS_AUTHKEY=
TS_HOSTNAME=einvoice
AI_ENABLED=true
# When the public demo is reset every night, Berlin time (HH:MM).
RESET_AT=03:00
